{
  "name": "watchlog-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:types": "npx --yes openapi-typescript@7.13.0 ../docs/openapi.json -o src/lib/api-types.ts",
    "verify": "node scripts/verify-flow.mjs",
    "verify:edges": "node scripts/verify-edges.mjs",
    "verify:detail": "node scripts/verify-detail.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:guest": "node scripts/verify-guest.mjs",
    "verify:all": "npm run verify && npm run verify:auth && npm run verify:guest && npm run verify:edges && npm run verify:detail"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tanstack/react-query": "5.108.0",
    "lucide-react": "1.75.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
