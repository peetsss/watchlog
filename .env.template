# Runtime
WATCHLOG_ENV=dev
WATCHLOG_SECRET_KEY=
WATCHLOG_PUBLIC_URL=http://localhost:8001
# Production image tag (CI sets this; `just prod` uses watchlog:prod)
# WATCHLOG_IMAGE=ghcr.io/owner/watchlog:v0.1.0
WATCHLOG_ALLOWED_HOSTS=localhost,127.0.0.1
WATCHLOG_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8001
WATCHLOG_LOG_FORMAT=text
WATCHLOG_DOCS_ENABLED=true
WATCHLOG_MAX_REQUEST_BODY_BYTES=1048576
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted.
# Empty means forwarded headers are ignored entirely.
WATCHLOG_TRUSTED_PROXY_IPS=

# TMDB (search, film import and watch availability)
# Recommended: v4 read access token
TMDB_ACCESS_TOKEN=
# Fallback: v3 API key
TMDB_API_KEY=
WATCHLOG_TMDB_LANGUAGE=en-US
WATCHLOG_DEFAULT_REGION=PL
WATCHLOG_SUPPORTED_REGIONS=PL
WATCHLOG_WATCH_PROVIDER_TTL_SECONDS=86400
WATCHLOG_PROVIDER_REFRESH_LIMIT=500

# Email (Resend in production; console in development)
WATCHLOG_MAIL_BACKEND=console
WATCHLOG_MAIL_FROM=
WATCHLOG_MAIL_REPLY_TO=
WATCHLOG_RESEND_API_KEY=

# Celery / observability
WATCHLOG_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
WATCHLOG_SENTRY_DSN=
WATCHLOG_RATE_LIMIT_ENABLED=true
WATCHLOG_REQUIRE_VERIFIED_EMAIL=true

# PostgreSQL
POSTGRES_DB=watchlog_v2
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=watchlog_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (sessions and lobby pub/sub)
WATCHLOG_REDIS_URL=redis://127.0.0.1:6379/0
